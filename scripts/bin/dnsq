#!/bin/sh
# desc: DNS lookup with a short answer plus the resolver that served it
# usage: dnsq <name> [type=A] [server]
set -eu
case "${1:-}" in '' | -h | --help) sed -n 's/^# usage: //p' "$0"; [ -n "${1:-}" ]; exit ;; esac
name=$1 type=${2:-A}
if [ -n "${3:-}" ]; then
  dig "@$3" "$name" "$type" +noall +answer +stats
else
  dig "$name" "$type" +noall +answer +stats
fi
