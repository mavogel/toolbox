#!/bin/sh
# desc: exec into the first pod whose name matches a regex
# usage: kexec <pod-regex> [namespace] [-- command...]
set -eu
case "${1:-}" in '' | -h | --help) sed -n 's/^# usage: //p' "$0"; [ -n "${1:-}" ]; exit ;; esac
pat=$1
shift
ns=${NAMESPACE:-default}
if [ $# -gt 0 ] && [ "$1" != "--" ]; then
  ns=$1
  shift
fi
[ "${1:-}" = "--" ] && shift
pod=$(kubectl get pods -n "$ns" -o name | sed 's|^pod/||' | grep -E -- "$pat" | head -n 1)
[ -n "$pod" ] || { echo "kexec: no pod matching '$pat' in $ns" >&2; exit 1; }
echo "kexec: $ns/$pod" >&2
[ $# -gt 0 ] || set -- sh
exec kubectl exec -it -n "$ns" "$pod" -- "$@"
