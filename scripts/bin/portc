#!/bin/sh
# desc: check whether TCP ports on a host accept connections
# usage: portc <host> <port> [port...]
set -eu
case "${1:-}" in '' | -h | --help) sed -n 's/^# usage: //p' "$0"; [ -n "${1:-}" ]; exit ;; esac
[ $# -ge 2 ] || { sed -n 's/^# usage: //p' "$0" >&2; exit 1; }
host=$1
shift
rc=0
for port in "$@"; do
  if nc -z -w 3 "$host" "$port" 2>/dev/null; then
    echo "open    $host:$port"
  else
    echo "closed  $host:$port"
    rc=1
  fi
done
exit "$rc"
